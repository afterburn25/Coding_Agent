{
  "name": "Chat Nexus",
  "version": "0.6.0-dev",
  "default_model_mode": "auto",
  "architecture": "Native .NET 8 WinForms/WebView2 UI host -> hidden loopback Python Agent Core -> Research/Image/Tool Modules -> Model Orchestrator -> bundled llama.cpp/local providers",
  "source_of_truth": "afterburn25/Coding_Agent",
  "test_checkpoint": 176,
  "next_milestone": "Dogfood the verified 176-test conversational build across several real sessions: validate temporal continuity and the NEXUS activity HUD, deliberately rate/correct replies, review/export conversational examples, then decide whether a dedicated conversation model/LoRA is warranted.",
  "ui_direction": "Chat-first center workspace; left nav; right Code Diff/Tasks/Terminal rail; official orbital CN logo",
  "delivery_target": "Small compressed update-aware Windows bootstrap installer EXE; portable ZIP secondary",
  "default_coding_models": {
    "fast_primary": "Qwen3 14B Q4_K_M",
    "deep_reviewer": "Qwen3-Coder 30B-A3B Instruct Q4_K_M"
  },
  "installer": {
    "canonical_script": "installer/ChatNexus.iss",
    "app_id": "ChatNexus.Afterburn25",
    "default_dir": "%LOCALAPPDATA%\\\\Programs\\\\Chat Nexus",
    "interactive_existing_install_action": "Update",
    "preserves_on_update": [
      "models",
      "data",
      "config.json",
      "Source Git workspace/task state",
      "workflows/"
    ],
    "downloads_default_coding_models_when_missing": true,
    "model_download_progress": "Inno Setup native install progress",
    "model_download_hash_verification": "SHA-256",
    "default_model_download_bytes": 27558441344,
    "default_model_download_gib": 25.66,
    "progress_ui": {
      "overall": "Inno Setup native install/update progress including ExternalSize model downloads",
      "model": "Second per-model progress bar under overall bar",
      "model_sequence": [
        "Qwen3 14B Q4_K_M",
        "Qwen3-Coder 30B-A3B Instruct Q4_K_M"
      ],
      "resets_between_models": true,
      "shows_downloaded_mb": true
    },
    "close_applications": "installer-owned",
    "restart_manager_close_disabled": true,
    "shutdown_sequence": [
      "graceful ChatNexus.exe process-tree close",
      "brief grace period",
      "force ChatNexus.exe cleanup",
      "force orphan ChatNexus.Backend.exe cleanup",
      "force llama-server.exe / llama.exe cleanup"
    ],
    "ci_running_app_close_smoke": true
  },
  "first_run_model_setup": {
    "starter": "Install recommended 14B",
    "full_stack": "Install full 14B + 30B stack",
    "deep_upgrade": "Add 30B deep coder",
    "checksum_verified": true,
    "auto_configure_after_download": true,
    "restart_after_configure": false,
    "live_runtime_reload": true,
    "starter_auto_start": true,
    "diagnostics": "Collapsed under Technical model status during setup",
    "install_path_visible": true,
    "free_disk_visible": true,
    "top_level_progress": true,
    "disk_preflight": true,
    "active_plan_controls_locked": true,
    "normal_windows_flow": "Installer bootstraps both 14B and 30B before setup completes",
    "in_app_flow": "Recovery/portable/manual repair path",
    "installer_skips_verified_models": true
  },
  "ci_hardening": "Installer/app smoke processes have explicit timeouts so hung setup/self-test runs fail deterministically.",
  "routing_telemetry": {
    "enabled_by_default": true,
    "path": ".agent/model_performance.json",
    "min_samples": 3,
    "weight": 20,
    "content_free": true,
    "api": "GET /api/model-telemetry"
  },
  "model_switching": {
    "accounts_for_reclaimable_resident_memory": true,
    "auto_activation_fallback": true,
    "reviewer_activation_fallback": true,
    "durable_stream_error_recovery": true,
    "managed_llama_near_ram_autofit": true,
    "near_ram_margin": "max(2 GB, min(6 GB, 8% total system RAM))",
    "observed_case": "30.0 GB estimated vs 29.8 GB available is allowed to runtime auto-fit"
  },
  "local_chat_latency": {
    "lightweight_utility_route": true,
    "utility_skips_repo_research_tools": true,
    "qwen3_14b_default_reasoning": "off unless explicitly overridden",
    "max_output_tokens": {
      "qwen3_14b": 2048,
      "qwen3_coder_30b": 8192,
      "generic": 4096
    },
    "sse_worker_queue": true,
    "heartbeat_seconds": 1,
    "heartbeat_fields": [
      "elapsed_seconds",
      "phase",
      "status",
      "model_id",
      "model_role"
    ],
    "client_heartbeat_status": true,
    "builtin_greetings": true,
    "builtin_capability_questions": true,
    "builtin_model_id": "builtin-local",
    "builtin_bypasses_model_readiness": true
  },
  "desktop_backend": {
    "log_path": "data/logs/backend-host.log",
    "redirects_stdout_stderr": true,
    "unexpected_exit_restart": true,
    "max_restart_attempts": 3,
    "interrupted_tasks_remain_recoverable": true
  },
  "task_state": {
    "newest_task_is_current": true,
    "older_interrupted_remains_recent": true,
    "stream_disconnect_request_scoped": true
  },
  "ui_cache": {
    "static_assets_no_store": true,
    "client_builtin_greeting_before_sse": true
  },
  "conversation_memory": {
    "enabled_by_default": true,
    "path": "data/conversation_memory.json",
    "persists_across_restart_and_update": true,
    "bounded_history": true,
    "preferences_and_rules": true,
    "correction_examples": true,
    "prompt_injection_of_saved_rules": true,
    "ui": "Local system → Memory & training",
    "api": "GET /api/conversation-memory"
  },
  "stream_recovery": {
    "durable_final_content": true,
    "completed_result_recovery": true,
    "request_scoped_task_matching": true,
    "newest_durable_task_preferred": true
  },
  "routing": {
    "short_non_coding_conversation": "utility",
    "primary_14b_background_prewarm": true
  },
  "conversation_manager": {
    "durable_sessions": true,
    "search_restore": true,
    "summaries": true,
    "personality": true,
    "scoped_memory": true,
    "feedback": true,
    "trainer_ui": "/trainer.html",
    "temporal_continuity": true,
    "recent_message_elapsed_context": true,
    "previous_conversation_recency": true,
    "mature_conversation_prompt": true,
    "dry_humor_when_appropriate": true,
    "lower_forced_followups": true,
    "feedback_exact_message_pairing": true,
    "verified_code_checkpoint": "2781447"
  },
  "knowledge_memory": {
    "enabled": true,
    "provenance": true,
    "freshness": true,
    "refresh_current_sensitive": true
  },
  "model_growth": {
    "base_model_preserved": true,
    "review_candidates": true,
    "dataset_export": true,
    "offline_training_jobs": [
      "lora",
      "qlora",
      "full_finetune"
    ],
    "evaluation": true,
    "promotion": true,
    "rollback": true,
    "positive_feedback_conversation_examples": true,
    "negative_feedback_signals": true,
    "negative_feedback_excluded_from_sft_targets": true
  },
  "conversation_policy": {
    "default": "permissive",
    "modes": [
      "permissive",
      "balanced",
      "strict"
    ],
    "hard_safety_off_mode": false,
    "live_api": [
      "GET /api/policy",
      "POST /api/policy/mode"
    ],
    "ui": "Local system → Conversation policy",
    "purpose": "reduce generic topic-based refusals and moralizing while preserving narrow hard tool/action safety",
    "ethical_temperature_default": 1,
    "ethical_temperature_range": [
      0,
      1
    ],
    "sampling_temperature_default": 0.2,
    "generic_refusal_retry": true,
    "generic_refusal_retry_limit": 3,
    "adult_only_consensual_explicit_text": true,
    "profanity_is_not_sexual_content": true,
    "generic_refusal_retry_limit_range": [
      0,
      5
    ],
    "rejected_refusal_removed_from_context": true,
    "refusal_stream_buffering": true,
    "refusal_exhaustion_reports_model_blocker": true,
    "verified_code_checkpoint": "dd34284"
  },
  "direct_image_routing": {
    "auto_text_to_image": true,
    "bypasses_chat_model": true,
    "permission_aware": true,
