{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "${component_diffusion_model}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "device": "auto",
      "dtype": "default"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "${component_text_encoder}",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "${component_vae}"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${source_image}"
    }
  },
  "6": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "images.image_1": [
        "5",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "prompt": "${prompt}",
      "negative_prompt": "${negative_prompt}",
      "resolution": 1024
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "6",
        1
      ],
      "latent_image": [
        "6",
        2
      ],
      "seed": "${seed}",
      "steps": "${steps}",
      "cfg": "${guidance}",
      "sampler_name": "${sampler_name}",
      "scheduler": "${scheduler}",
      "denoise": "${denoise_strength}"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "ChatNexus/Qwen21-Edit",
      "images": [
        "8",
        0
      ]
    }
  }
}