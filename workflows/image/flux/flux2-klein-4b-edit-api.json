{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "${component_diffusion_model}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "${component_text_encoder}",
      "type": "flux2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "${component_vae}"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${source_image}"
    }
  },
  "5": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "4",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        0
      ]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "${prompt}",
      "clip": [
        "2",
        0
      ]
    }
  },
  "8": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": "${steps}",
      "width": "${width}",
      "height": "${height}"
    }
  },
  "9": {
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": "${guidance}",
      "model": [
        "1",
        0
      ],
      "positive": [
        "7",
        0
      ],
      "negative": [
        "6",
        0
      ]
    }
  },
  "10": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "11": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "${seed}"
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "11",
        0
      ],
      "guider": [
        "9",
        0
      ],
      "sampler": [
        "10",
        0
      ],
      "sigmas": [
        "8",
        0
      ],
      "latent_image": [
        "5",
        0
      ]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "12",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "13",
        0
      ],
      "filename_prefix": "ChatNexus/Flux2-Klein-Edit"
    }
  }
}
