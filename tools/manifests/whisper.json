{
  "id": "whisper",
  "name": "whisper.cpp",
  "version": "1.0.0",
  "category": "audio",
  "description": "Local speech-to-text via whisper.cpp (whisper-cli). Requires a downloaded GGML model; pass its path with -m.",
  "provider": "ggerganov",
  "executables": ["whisper-cli"],
  "capabilities": ["transcribe_audio", "transcribe_video", "generate_subtitles", "detect_language"],
  "permissions": ["shell.execute"],
  "requires_network": false,
  "requires_gpu": false,
  "requirements": {"ram_mb": 1024},
  "docs": "https://github.com/ggml-org/whisper.cpp",
  "detect": {"files": ["whisper/Release/whisper-cli.exe"]},
  "install": {"method": "archive",
              "url": "https://github.com/ggml-org/whisper.cpp/releases/download/b5130/whisper-bin-x64.zip",
              "sha256": "f9ec6c52a2e949b62ab51fa21d0d497958f9e41c3010c157c4e42932d5316f3c",
              "size_bytes": 8573270,
              "format": "zip",
              "dest": "whisper",
              "notes": "Downloads the official whisper-bin-x64 release. A GGML model is still required; place ggml-*.bin under models/audio/."},
  "health_check": {"command": ["whisper-cli", "--help"]},
  "invoke": {
    "command": ["whisper-cli", "-m", "{model}", "-f", "{file}", "-oj", "-osrt", "{args}"],
    "input_schema": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "description": "path to a GGML whisper model, e.g. models/audio/ggml-base.en.bin"},
        "file": {"type": "string", "description": "audio/video file (16kHz wav preferred)"},
        "args": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["model", "file"]
    },
    "timeout_seconds": 1800
  }
}
