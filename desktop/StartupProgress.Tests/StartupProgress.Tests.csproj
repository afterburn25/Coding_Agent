<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StartupProgress.Tests</AssemblyName>
    <!-- The model under test is compiled in directly — no WinForms deps. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\ChatNexus.Desktop\StartupProgress.cs" Link="StartupProgress.cs" />
    <Compile Include="..\ChatNexus.Desktop\StartupNarrator.cs" Link="StartupNarrator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SoundPlayer lives in the WindowsDesktop shared framework. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
