<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexusCore</AssemblyName>
    <RootNamespace>ChatNexus.Desktop</RootNamespace>
    <ApplicationIcon>nexus-core.ico</ApplicationIcon>
    <Version>0.33.0</Version>
    <FileVersion>0.33.0.0</FileVersion>
    <AssemblyVersion>0.33.0.0</AssemblyVersion>
    <Authors>Afterburn25</Authors>
    <Company>Afterburn25</Company>
    <Copyright>Nexus Core</Copyright>
    <AssemblyTitle>Nexus Core</AssemblyTitle>
    <Product>Nexus Core</Product>
    <Description>Nexus Core local AI workstation</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="nexus-core.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="nexus-core-splash.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="nexus-core-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cinematic splash: manifest + audio stems + web runtime. -->
    <Content Include="splash\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
